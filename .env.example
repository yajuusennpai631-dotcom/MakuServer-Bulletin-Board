# Railway sets PORT automatically.
# Add a Railway PostgreSQL service and reference its DATABASE_URL here.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Optional: channel ID where new submissions are announced for review.
DISCORD_REVIEW_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to moderate (server administrators also allowed).
ADMIN_USER_IDS=

# Optional: protect the website's moderation API with a long random token.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional. Set to disable SSL for a local PostgreSQL instance only.
# PGSSLMODE=disable
